# Forex Telegram Bot v2 — single process

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ADMIN_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_PUBLIC_CHAT_ID=-100xxxxxxxxxx
# Optional. Leave blank to disable the writing destination.
TELEGRAM_WRITING_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_WRITING_DISABLED=false

# Auto-publish
AUTO_APPROVE=true
AUTO_PUBLISH_TELEGRAM=true
AUTO_APPROVE_GRACE_SECONDS=90

# LLM (optional — for AI draft generation)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.5-flash

# Data sources
# Apify runs for the 07:00 UTC morning discover and for one-shot actual fetches
# when high-impact events hit release time.
# Leave APIFY_TOKEN blank, or set APIFY_TOKEN_DISABLED=... to keep Apify off.
APIFY_TOKEN=
APIFY_TOKEN_DISABLED=
APIFY_ACTOR_ID=pintostudio/economic-calendar-data-investing-com
APIFY_MACRO_COUNTRIES=united states
APIFY_MACRO_DAYS_AHEAD=3
# Leave enabled only if you want release-time Telegram drafts.
RELEASE_ALERT_ENABLED=true
ACTUAL_ALERT_ENABLED=true
ACTUAL_LOOKBACK_MINUTES=120

# Google Sheets (legacy optional - CMS is primary)
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_URL=
# GOOGLE_OAUTH_TOKEN_PATH=
# GOOGLE_OAUTH_CREDENTIALS_PATH=

# Runtime
PORT=8788
DB_PATH=/data/forex-bot.db
NODE_ENV=production
USE_POLLING=true

# Optional CMS web research (better than free RSS)
# SERPER_API_KEY=
# TAVILY_API_KEY=

# Website-to-CMS members webhook — SECRET: use a long random shared value.
# The website sends this in the X-Forexis-Webhook-Secret header to POST /api/members.
FOREXIS_WEBHOOK_SECRET=
# Backwards-compatible alternative name. Set one of these two variables, not both.
FOREX_CMS_WEBHOOK_SECRET=
